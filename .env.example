# Supabase → Project Settings → API (or "Connect" → App frameworks)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" (publishable) key. Safe in the browser: every table is
# protected by Row Level Security (supabase/migrations).
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: show "Continue with Google" (set up the Google provider first)
VITE_AUTH_GOOGLE=false


# Optional: currency for amounts (ISO code), default USD
VITE_CURRENCY=USD
